{
  "name": "carnet-de-route",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Carnet de route : scénarios de voyage personnalisables, et export d'une visite animée en un fichier HTML",
  "scripts": {
    "dev": "npm run build:visite && vite",
    "build:visite": "vite build --config vite.visite.config.ts",
    "build": "tsc --noEmit && npm run build:visite && vite build && node scripts/renommer.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.9"
  }
}
